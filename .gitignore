# ---- Дані користувача (НІКОЛИ не комітити) ----
# Три окремі корені живуть під user_data/: brain (інфа про юзера),
# workspace (файли бота) і code (код-проєкти). Шляхи задає config.yaml →
# paths.*_dir; ігноруємо і їх, і старі місця, якщо конфіг повернуть назад.
Virtual Bot/user_data/
Virtual Bot/brain/
Virtual Bot/workspace/
Virtual Bot/code/
# Встановлені пакети магазину екрана — runtime-копії з store/packages/
Virtual Bot/store/installed/

# ---- Runtime-стан агентів (МІСТИТЬ credential-и: opencode account.json) ----
Virtual Bot/runtime/

# ---- Внутрішній стан AI-інструментів (не джерело проєкту) ----
.crab/
.zcode/
