{
  "name": "@claude-bot/app",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "description": "«Клод Бот» — один UI на React Native: веб, iOS, Android, Electron",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:web": "expo export --platform web --output-dir dist",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@claude-bot/core": "*",
    "@expo/metro-runtime": "~57.0.12",
    "expo": "~57.0.15",
    "expo-constants": "~57.0.13",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  }
}
